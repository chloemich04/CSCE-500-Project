# Copy this file to .env and fill in your real values.
# Never commit .env (it is already listed in .gitignore).

# PostgreSQL connection string from Supabase
# Project Settings → Database → Connection string (URI)
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.zpchspwmiujdxyiofomu:SoftwareMethodology91@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Secret used to sign JWT access tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: token lifetime in minutes (default 60)
JWT_EXPIRE_MINUTES=60

# Optional: HTTP port (default 8000)
PORT=8000
